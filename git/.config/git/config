# No email address here on purpose — this repo is public, and an address is a property of
# the machine or repo. Set it in ~/.config/git/config.local, along with anything else
# specific to the machine.

[user]
	name = Jeff Mohan

[commit]
	gpgsign = true

[gpg]
	format = ssh

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	side-by-side = true
	syntax-theme = base16
	wrap-max-lines = 10 # Show most content; truncate for super-long autogen stuff
	file-style = bold brightwhite
	file-decoration-style = brightwhite ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = blue ul
	hunk-header-line-number-style = blue ul
	# No padding option, so a rule is the only way to get a gap under hunk header
	hunk-header-decoration-style = 18 ul
	merge-conflict-ours-diff-header-decoration-style = blue ul
	merge-conflict-theirs-diff-header-decoration-style = blue ul
	line-numbers-left-style = brightblack
	line-numbers-right-style = brightblack
	line-numbers-zero-style = brightblack

[diff]
	algorithm = histogram

[merge]
	conflictStyle = zdiff3

# Keep last: later values override earlier ones. Silently skipped if absent.
[include]
	path = ~/.config/git/config.local
