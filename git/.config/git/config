# No email address here on purpose — this repo is public, and an address is a property of
# the machine or repo. Set it in ~/.config/git/config.local, along with anything else
# specific to the machine.

[user]
	name = Jeff Mohan

[commit]
	gpgsign = true

[gpg]
	format = ssh

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = gruvbox-dark

[diff]
	algorithm = histogram

[merge]
	conflictStyle = zdiff3

# Keep last: later values override earlier ones. Silently skipped if absent.
[include]
	path = ~/.config/git/config.local
