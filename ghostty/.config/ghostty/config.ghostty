# Display
#
# This is the whole palette. tmux, fish, and starship name the 16 ANSI slots rather
# than hex, so `theme` re-colours all of them at once; `ghostty +list-themes` is the
# candidate pool. Only neovim needs a matching edit, in its own colourscheme.
#
# Slot 18 is the chrome band: the tmux status bar and the starship prompt both need a
# shade off the background, and the 16 slots have none. base24 assigns that role to
# slot 18 ("lighter background, used for status bars"), so this follows the spec
# rather than inventing a slot. The value is Kanagawa's own sumiInk5.
theme = Kanagawa Wave
palette = 18=#363646
font-family = "FiraMono Nerd Font Mono"
font-size = 12

# ghostty is just hosting tmux, which already has its own status bar
# (loses ability to drag the window, but I just use keyboard shortcuts for that)
macos-titlebar-style = hidden

# Behavior
window-inherit-font-size = false
macos-option-as-alt = true
mouse-hide-while-typing = true

# send Ctrl+Shift+Arrow (Mac tab-switching, also built as keyboard chords) through as
# special escape sequences that tmux.conf binds to window-switching
keybind = super+alt+arrow_right=csi:1;6C
keybind = super+alt+arrow_left=csi:1;6D
# send Cmd+E through as escape sequence to open the workmux dashboard
keybind = super+e=csi:101;6u

# machine-local overrides
config-file = ?~/.config/ghostty/config.ghostty.local
